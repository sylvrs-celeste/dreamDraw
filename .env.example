# dreamDraw — environment template.
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.

# ---------------------------------------------------------------- database
# Async driver (asyncpg). Host `db` is the compose service name.
DATABASE_URL=postgresql+asyncpg://dreamdraw:dreamdraw@db:5432/dreamdraw

# Consumed by the postgres container itself.
POSTGRES_USER=dreamdraw
POSTGRES_PASSWORD=dreamdraw
POSTGRES_DB=dreamdraw

# ---------------------------------------------------------------- auth
# bcrypt hash of the single admin password — NOT the password itself. Generate with:
#   docker compose run --rm api python -c \
#     "from passlib.hash import bcrypt; print(bcrypt.hash('your-password'))"
ADMIN_PASSWORD_HASH=

# Signing key for session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=

# ---------------------------------------------------------------- aws
# Provisioned by hand in the console; paste the resulting values here.
S3_BUCKET=
AWS_REGION=us-east-1

# Local development only. On EC2 these stay empty — credentials come from the
# IAM instance role, and no long-lived keys should ever exist on the instance.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- app
# `dev` enables /docs and permissive CORS. Use `prod` on the instance.
ENV=dev

# Browser origin allowed to call the API. In production everything is same-origin
# through CloudFront, so this is only needed for the local Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173
