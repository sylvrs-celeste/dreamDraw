# Pinned to 3.12 deliberately. The dev host runs 3.14, which is new enough that
# some of these wheels do not exist for it yet; the container is what matters.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv

# Requirements first so the layer caches: application edits do not force a
# reinstall of Pillow and boto3 on every build.
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# Run as nobody. Nothing here writes to disk -- images go to S3 and data to
# Postgres -- so there is no reason for the process to own its own files.
RUN chown -R nobody:nogroup /srv
USER nobody

EXPOSE 8000

# One worker on purpose. The login rate limiter keeps its counters in process
# memory, so each extra worker multiplies the effective limit by one. This is a
# single small instance serving one person's gallery; concurrency is not the
# constraint.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
